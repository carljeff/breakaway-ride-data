@@ -0,0 +1,11 @@
+import bundled from "./race-results.json";
+import type {RaceEvidence} from "./race-analysis";
+export async function raceEvidence(rideId:string):Promise<RaceEvidence[]>{
+ // Data registry, not per-activity production detection logic. No credentials required.
+ let registry:unknown=bundled;
+ try{const r=await fetch("https://raw.githubusercontent.com/carljeff/breakaway-ride-data/main/data/race-results.json",{cache:"no-store"});if(r.ok)registry=await r.json()}catch{}
+ const rows=(registry as {results?:Record<string,unknown>})?.results?.[rideId];
+ if(!Array.isArray(rows))return[];
+ const kinds=new Set(["official_timestamps","validated_metadata","route_distance","manual_verified","official_elapsed"]);
+ return rows.filter(v=>v&&typeof v==="object"&&kinds.has(v.kind)&&typeof v.source==="string"&&v.source.trim()&&typeof v.verifiedAt==="string"&&!Number.isNaN(Date.parse(v.verifiedAt)));
+}
