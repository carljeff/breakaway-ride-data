+import type {analyzeRace} from "./race-analysis";
+type Analysis=ReturnType<typeof analyzeRace>;
+export function racePayload(a:Analysis,details=false){
+ if(details)return a;
+ const compact=(event:Analysis["events"]["accelerations"][number])=>({kind:event.kind,elapsedStartSeconds:event.elapsedStartSeconds,elapsedEndSeconds:event.elapsedEndSeconds,startDistanceMeters:event.startDistanceMeters,endDistanceMeters:event.endDistanceMeters,durationSeconds:event.durationSeconds,power:event.power,heartRate:event.heartRate,cadence:event.cadence,confidence:event.confidence});
+ return{...a,timeline:undefined,events:{climbs:a.events.climbs.map(compact),accelerations:a.events.accelerations.map(compact),sustainedEfforts:a.events.sustainedEfforts.map(compact)},repeatability:{...a.repeatability,efforts:undefined}};
+}
