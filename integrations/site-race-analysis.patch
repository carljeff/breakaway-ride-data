+"use client";
+import type {analyzeRace} from "@/lib/race-analysis";
+type Analysis=ReturnType<typeof analyzeRace>;
+export function RaceSummary({data}:{data:Analysis}){
+ const fmt=(s:number|null|undefined)=>s==null?"Unknown":`${Math.floor(s/60)}:${String(Math.round(s%60)).padStart(2,"0")}`;
+ const official=data.officialResult,metrics=data.raceMetrics??data.candidateRaceMetrics,t=data.timeline??[],end=data.recordedActivityDurationSeconds,x=(s:number)=>30+740*s/end,y=(p:number)=>200-p/Math.max(450,...t.map(v=>v.powerWatts??0))*160,b=data.boundary;
+ return <section className="card race-summary"><p className="eyebrow">RACE-SPECIFIC · READ ONLY</p><h2>Race result, not recording duration</h2><p>Official time: <b>{fmt(official?.officialDurationSeconds)}</b> · Recorded activity: {fmt(end)}{official?.position?` · Position ${official.position}`:""}{official?.gapToWinnerSeconds!=null?` · Gap +${official.gapToWinnerSeconds.toFixed(2)} sec`:""}</p><p>Official average: <b>{official?.averagePowerWatts??"—"} W</b> · {b.status==="verified"?"Race-only":"Provisional stream window"}: {metrics?.power.averageWatts??"—"} W average / {metrics?.power.normalizedWatts??"—"} W normalized</p><p>Boundary: {b.status} · {b.confidence} confidence. {b.source}</p>{t.length>0&&<svg viewBox="0 0 800 230" role="img" aria-label="Recorded power timeline; green verified race or amber uncertain candidate; gray post-window recording"><rect x="30" y="30" width="740" height="175" fill="#9aa59f" opacity=".15"/>{(b.finishElapsedSeconds!==null||b.candidate)&&<rect x={x(b.startElapsedSeconds??b.candidate?.startElapsedSeconds??0)} y="30" width={740*((b.finishElapsedSeconds??b.candidate?.finishElapsedSeconds??0)-(b.startElapsedSeconds??0))/end} height="175" fill={b.status==="verified"?"#44a878":"#eab44e"} opacity=".25"/>}{t.slice(1).map((v,i)=>v.powerWatts!==null&&t[i].powerWatts!==null?<line key={i} x1={x(t[i].elapsedSeconds)} y1={y(t[i].powerWatts!)} x2={x(v.elapsedSeconds)} y2={y(v.powerWatts)} stroke="#ff6846"/>:null)}{[0,.5,1].map(n=><text key={n} x={x(n*end)} y="225" textAnchor="middle">{fmt(n*end)}</text>)}</svg>}<p>{data.events.climbs.length} detected climbs · {data.events.accelerations.length} measured accelerations. Group dynamics and tactical intent are unknown.</p>{official&&<p><small>Official source: {official.source}</small></p>}<div className="power-stats">{Object.entries(metrics?.powerDurationWatts??{}).map(([duration,power])=><span key={duration}><small>{duration}</small><b>{power??"—"} W</b></span>)}</div>{data.dataQuality.warnings.map(w=><p key={w}><small>{w}</small></p>)}</section>
+}
